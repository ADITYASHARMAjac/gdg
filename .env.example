# ==============================================================================
# FlowSplit Online-Only Environment Configuration Template (.env.example)
# Copy this file to .env and supply your credentials.
# Note: SQLite and offline mode are completely disabled. Real online APIs are used.
# ==============================================================================

# 1. Google Maps Platform Keys & URLs
# Browser Key: Restricted to Maps JavaScript API and HTTP referrers (e.g. http://localhost:8000/*)
GOOGLE_MAPS_BROWSER_KEY=your_google_maps_browser_key_here
GOOGLE_MAPS_JS_API_URL=https://maps.googleapis.com/maps/api/js

# Backend Server Keys & Endpoints: Google Routes API v2
GOOGLE_ROUTES_API_KEY=your_google_routes_api_server_key_here
GOOGLE_ROUTES_API_URL=https://routes.googleapis.com/directions/v2:computeRoutes

# Google Street View Static API Key & Endpoints
GOOGLE_STREET_VIEW_API_KEY=your_street_view_api_server_key_here
GOOGLE_STREET_VIEW_METADATA_URL=https://maps.googleapis.com/maps/api/streetview/metadata
GOOGLE_STREET_VIEW_IMAGE_URL=https://maps.googleapis.com/maps/api/streetview

# 2. Google Gemini Vision Analysis API
# Server-side key for multimodal road inspection using official google-genai SDK
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_URL=https://generativelanguage.googleapis.com

# 3. Server Host & API Network Configuration
HOST=0.0.0.0
PORT=8000
API_BASE_URL=http://localhost:8000
ENVIRONMENT=development

# 4. Data Persistence (No SQLite for now)
# FlowSplit runs with zero-config in-memory persistence by default.
# For production PostgreSQL, supply your connection string:
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/flowsplit

# 5. Shared Cache & Registry (Optional)
REDIS_URL=

# 6. Pipeline Parameters & Operational Bounds
SAMPLE_INTERVAL_METERS=100.0
MAX_IMAGE_BUDGET_PER_ROUTE=10
REQUEST_TIMEOUT_SECONDS=15.0
MAX_RETRIES=3

# 7. Operational Mode
ONLINE_MODE_ONLY=true
