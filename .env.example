# ==============================================================================
# FlowSplit Environment Configuration Template (.env.example)
# Copy this file to .env and supply your credentials, or run directly in offline demo mode.
# ==============================================================================

# 1. Google Maps Platform Keys
# Browser Key: Restricted to Maps JavaScript API and HTTP referrers (e.g. http://localhost:8000/*)
GOOGLE_MAPS_BROWSER_KEY=your_google_maps_browser_key_here

# Backend Server Keys: Restricted to IP address or internal server environment
GOOGLE_ROUTES_API_KEY=your_google_routes_api_server_key_here
GOOGLE_STREET_VIEW_API_KEY=your_street_view_api_server_key_here

# 2. Google Gemini Vision Analysis API
# Server-side key for multimodal road inspection using official google-genai SDK
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# 3. Data Persistence
# SQLite (default for development/testing) or PostgreSQL for production:
DATABASE_URL=sqlite+aiosqlite:///./flowsplit.db
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/flowsplit

# 4. Optional Shared Cache & Route Registry (In-memory fallback is used if omitted)
REDIS_URL=
# REDIS_URL=redis://localhost:6379/0

# 5. Pipeline Parameters & Operational Bounds
SAMPLE_INTERVAL_METERS=100.0
MAX_IMAGE_BUDGET_PER_ROUTE=10
REQUEST_TIMEOUT_SECONDS=15.0
ENVIRONMENT=development
DEMO_MODE_DEFAULT=false
